# ==========================================
# Suwa Sarana — Root Environment Variables
# ==========================================

# Database
POSTGRES_DB=suwa_sarana_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
DB_URL=jdbc:postgresql://localhost:5432/suwa_sarana_dev

# Backend Security
JWT_SECRET=dGhpcy1pcy1hLXZlcnktbG9uZy1zZWNyZXQta2V5LXRvLW1lZXQtam1hYy1yZXF1aXJlbWVudHM=
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Third-party Integrations
SMS_PROVIDER_API_KEY=mock_key
SMS_CASCADE_TIMEOUT_SECONDS=180
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend (compiled into the browser bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Refresh-token cookie (production: keep COOKIE_SECURE=true; use COOKIE_SAME_SITE=None only if frontend and API are on different sites)
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
