# =====================================================================================================
# Suwa Sarana - root environment (used by `docker-compose.yml` and the frontend build)
#
# Copy to `.env` (git-ignored). Backend runtime variables are documented in apps/backend/.env.example; docker
# compose runs the backend with the lenient `dev` profile and its own throw-away DB/JWT values, so nothing secret
# is needed here for a local run. NEVER commit real values.
# =====================================================================================================

# --- Passed through to the backend container by docker-compose -------------------------------------------
# Google OAuth web client id (public). Empty disables Google sign-in.
GOOGLE_CLIENT_ID=
# Groq LLM key (request intake, FAQ, triage). Empty uses the deterministic fallbacks.
GROQ_API_KEY=

# --- Frontend (compiled into the browser bundle at build time: only public values!) -------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Production reminder -----------------------------------------------------------------------------
# Real deployments do not use docker-compose or this file: the backend image runs the `prod` profile and
# requires JWT_SECRET, DB_URL/DB_USER/DB_PASSWORD, CORS_ALLOWED_ORIGIN, FRONTEND_URL, PUBLIC_BASE_URL (and COOKIE_SECURE=true)
# from AWS Secrets Manager / SSM. See apps/backend/.env.example.
