# =====================================================================================================
# Suwa Sarana — Production Environment Variables Template (.env.production)
#
# Generate strong secrets:
#   JWT_SECRET:  openssl rand -base64 64
#   DB_PASSWORD: openssl rand -hex 16
# =====================================================================================================

# -----------------------------------------------------------------------------------------------------
# 1. Database Configuration
# If using containerized Postgres (included in docker-compose.prod.yml):
# -----------------------------------------------------------------------------------------------------
POSTGRES_DB=suwa_sarana_prod
DB_USER=suwa_admin
DB_PASSWORD=replace_with_strong_database_password_at_least_16_chars
DB_URL=jdbc:postgresql://db:5432/suwa_sarana_prod

# If using AWS RDS PostgreSQL Free Tier instead of container, change DB_URL:
# DB_URL=jdbc:postgresql://your-rds-endpoint.czxxxx.us-east-1.rds.amazonaws.com:5432/suwa_sarana_prod

# -----------------------------------------------------------------------------------------------------
# 2. Security & JWT
# Must be standard Base64 of at least 32 bytes (64 recommended)
# -----------------------------------------------------------------------------------------------------
JWT_SECRET=replace_with_base64_encoded_64_bytes_from_openssl

# -----------------------------------------------------------------------------------------------------
# 3. Domain & Networking URLs
# For initial test without custom domain: http://<YOUR_EC2_PUBLIC_IP>
# For production with domain & SSL: https://yourdomain.com
# -----------------------------------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=http://localhost
FRONTEND_URL=http://localhost
PUBLIC_BASE_URL=http://localhost

# Frontend Build Parameters
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------------------------------
# 4. HTTP / HTTPS Flags
# When testing on EC2 IP before domain and SSL cert are added:
# -----------------------------------------------------------------------------------------------------
ALLOW_HTTP=true
COOKIE_SECURE=false

# When you add a custom domain with HTTPS (Certbot SSL), change to:
# ALLOW_HTTP=false
# COOKIE_SECURE=true

# -----------------------------------------------------------------------------------------------------
# 5. External API Integrations (Optional)
# -----------------------------------------------------------------------------------------------------
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
SMS_PROVIDER_API_KEY=mock_key
