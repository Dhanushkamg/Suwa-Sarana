# Backend REST API base URL (must include /api).
# Local backend on this machine: it listens on port 8081 because Apache owns 8080 (see docs/LOCAL-RUN.md).
# A backend started with its default port uses http://localhost:8080/api instead.
NEXT_PUBLIC_API_URL=http://localhost:8081/api
# Public site origin (canonical URLs, sitemap, share cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google sign-in (optional; the button is hidden when empty)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
