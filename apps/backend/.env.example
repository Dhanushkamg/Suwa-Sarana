# =====================================================================================================
# Suwa Sarana API - environment variables (apps/backend)
#
# Copy to `.env` (git-ignored) for local use or provide the same variables through your platform
# (ECS task definition / AWS Secrets Manager / SSM Parameter Store). NEVER commit real values.
#
# Profiles (SPRING_PROFILES_ACTIVE):
#   dev  - local development: throw-away DB/JWT defaults, demo accounts, plain-text logs. Everything below is optional.
#   prod - container default: JSON logs and a STRICT start-up check. The API refuses to start unless JWT_SECRET,
#          DB_*, CORS_ALLOWED_ORIGIN, FRONTEND_URL and PUBLIC_BASE_URL are set to safe values (no known/weak
#          secrets, https URLs, no wildcard CORS, no demo seed). Any profile other than dev/test is strict.
# =====================================================================================================

# --- Runtime ----------------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
# HTTP port inside the container/process.                                       (default 8080)
PORT=8080
# JVM flags (container image only). Defaults: MaxRAMPercentage=75, ExitOnOutOfMemoryError, UTC zone.
# JAVA_OPTS=
# Grace period for in-flight requests on SIGTERM.                              (default 30s)
SHUTDOWN_TIMEOUT=30s
# How the API learns the real client IP / scheme behind a proxy: native (ALB/nginx, trusts private ranges) | none
# Wrong value => every client shares the load balancer's IP in rate limits and audit logs.   (default native)
FORWARD_HEADERS_STRATEGY=native
# Regex of the proxy/ALB addresses whose X-Forwarded-For is trusted (empty = trust none). Behind an AWS ALB use your VPC range, e.g. 10.d+.d+.d+
TRUSTED_PROXY_REGEX=

# --- Database (REQUIRED outside dev) -----------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/suwa_sarana_dev
DB_USER=postgres
# Generated password, >= 12 chars. Weak/known values (postgres, password123 ...) are rejected outside dev.
DB_PASSWORD=
# Connection pool. Keep (tasks x DB_POOL_MAX) below the database's max_connections.
DB_POOL_MAX=15
DB_POOL_MIN_IDLE=5
# none | validate. `validate` makes Hibernate check entities against the Flyway schema at start-up.   (default none)
JPA_DDL_AUTO=none
# Flyway placeholder `environment`. V22 deletes the seeded demo users/data when it is not 'dev'.
# Default: dev under the dev profile, prod otherwise. Leave unset; never set to dev on a real database.
# APP_ENV=prod

# --- Security (REQUIRED outside dev) -----------------------------------------------------------------
# Base64 of >= 32 random bytes (64 recommended):   openssl rand -base64 64
# Rotating it signs every user out. The old committed development secrets are rejected.
JWT_SECRET=
# Exact browser origin(s) allowed to call the API, comma separated, no wildcard, no trailing path.
# Example: https://suwasarana.lk,https://www.suwasarana.lk
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Refresh-token cookie. COOKIE_SECURE must be true outside dev (HTTPS). Use SameSite=None only when the
# frontend and API are on different sites (requires Secure).
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- URLs (REQUIRED outside dev, https, no trailing slash) --------------------------------------------
# Public URL of the web frontend: used in SMS/email links and circle invite links.
FRONTEND_URL=http://localhost:3000
# Public URL of this API as clients see it (webhook signature URLs, absolute links).
PUBLIC_BASE_URL=http://localhost:8080

# --- Time -----------------------------------------------------------------------------------------------
# Zone for donor quiet hours, "today" and reminder windows. Timestamps are stored in UTC regardless.
APP_TIME_ZONE=Asia/Colombo

# --- Third-party integrations -------------------------------------------------------------------------
# Google OAuth web client id (public value). Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Groq LLM key for request intake, FAQ and triage. Without it the deterministic fallbacks are used.
GROQ_API_KEY=
# SMS gateway credentials (Notify.lk / Dialog / Twilio ...). Empty = SMS goes to the log only.
SMS_PROVIDER_API_KEY=
SMS_CASCADE_TIMEOUT_SECONDS=180

# --- Demo data (dev profile only) ------------------------------------------------------------------------
# Creates admin@test.com, donor@test.com ... with a publicly known password (see DataInitializer).
# Ignored outside the dev profile; the start-up check refuses to boot any other profile with this set to true.
SEED_DATA_ENABLED=true
