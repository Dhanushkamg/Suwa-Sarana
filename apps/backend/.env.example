# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/suwa_sarana_dev
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Security — generate a strong secret: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION_USE_A_STRONG_64_BYTE_BASE64_SECRET

# CORS Configuration
CORS_ALLOWED_ORIGIN=http://localhost:3000

# SMS Provider Integration (Fallback channel)
SMS_PROVIDER_API_KEY=mock_key
SMS_CASCADE_TIMEOUT_SECONDS=180

# Groq LLM API Configuration (AI Request Intake, FAQ & Triage)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Seed development test accounts (NEVER set to true in production)
SEED_DATA_ENABLED=true
